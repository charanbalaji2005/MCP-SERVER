# Copy this file to .env and adjust as needed.
# Never commit your real .env file.

# --- Security boundary -------------------------------------------------
# ALL filesystem / directory / find / git tools are confined inside this
# directory. Paths that resolve outside it (via .., symlinks, or absolute
# paths elsewhere) are rejected.
MCP_WORKSPACE=./workspace

# Max file size (bytes) that read_file / write_file / hash-like ops allow.
MCP_MAX_FILE_SIZE=10485760

# Max bytes fetch_url will read from a remote response.
MCP_MAX_RESPONSE_SIZE=5242880

# Timeout (seconds) for outbound HTTP requests made by fetch_url.
MCP_HTTP_TIMEOUT=10

# Max recursion depth for list_directory(recursive=True) / find_files.
MCP_MAX_DIRECTORY_DEPTH=12

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
MCP_LOG_LEVEL=INFO

# Allow fetch_url to reach private/loopback/link-local addresses.
# Leave "false" unless you specifically need to hit internal services.
MCP_ALLOW_PRIVATE_NETWORK=false

# --- Transport -----------------------------------------------------------
# "stdio" (default): for LOCAL use only. An MCP client (Claude Code, Claude
#   Desktop, etc.) launches this process directly and talks to it over its
#   own stdin/stdout. Nothing is exposed on the network. Use this unless
#   you specifically need remote access.
# "streamable-http": binds a network port so a REMOTE client can connect.
#   This has NO built-in authentication -- you must put it behind a
#   reverse proxy (nginx/Caddy) that terminates TLS and enforces auth, or
#   keep it on a private network/VPN. Do not expose it directly.
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765

